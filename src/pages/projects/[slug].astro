---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate, fmtSize } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.data.slug }, props: { p } }));
}

const { p } = Astro.props;
const d = p.data;
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts', (x) => x.data.project === d.slug)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title={d.name} description={d.tagline}>
  <h1>{d.name}</h1>
  <p class="lead">{d.tagline}</p>

  {
    d.claude && (
      <p class="note">
        <span class="badge">Claude Code</span> Claude Code と一緒に使う前提のものです。使い方は GitHub の README にあります。
        <a href={`${base}claudes/`}>ほかのもの →</a>
      </p>
    )
  }

  {d.description && <p>{d.description}</p>}

  {
    d.features.length > 0 && (
      <>
        <h2>できること</h2>
        <ul class="features">
          {d.features.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </>
    )
  }

  {
    d.screenshots.length > 0 && (
      <div class="shots">
        {d.screenshots.map((s) => (
          <img src={s} alt={`${d.name} の画面`} loading="lazy" />
        ))}
      </div>
    )
  }

  {
    /* Claude Code 前提のものは Release が無いことが多い。そのときは「まだリリースはありません」も出さない */
    !(d.claude && !d.latest) && (
      <>
        <h2>ダウンロード</h2>
        <div class="download">
          {
            d.latest ? (
              <>
                <div>
                  <strong>{d.latest.name}</strong> <span class="muted small">{fmtDate(d.latest.date)}</span>
                </div>
                {d.latest.assets.length > 0 && (
                  <ul>
                    {d.latest.assets.map((a) => (
                      <li>
                        <a href={a.url}>{a.name}</a> <span class="muted small">{fmtSize(a.size)}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="small">
                  <a href={d.latest.url}>Release のページ</a>
                  {d.platforms && <> ・ 動作環境: {d.platforms}</>}
                </p>
              </>
            ) : (
              <p class="muted">まだリリースはありません。</p>
            )
          }
        </div>
      </>
    )
  }

  <p>
    <a class="btn" href={d.repoUrl}>GitHub で見る</a>
    {d.links.map((l) => <a class="btn" href={l.url}>{l.label}</a>)}
    {d.license && <span class="muted small"> ライセンス: {d.license}</span>}
  </p>

  {
    posts.length > 0 && (
      <>
        <h2>更新履歴</h2>
        <ul class="list">
          {posts.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
              <a href={`${base}posts/${post.id}/`}>{post.data.tag}</a>
              {post.data.prerelease && <span class="badge">プレリリース</span>}
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>
