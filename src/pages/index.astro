---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE, byLatest, fmtDate } from '../site';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects', (p) => p.data.listed && !p.data.claude)).sort(byLatest);
const claudes = await getCollection('projects', (p) => p.data.listed && p.data.claude);
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 10);
---

<Base>
  <h1>{SITE.title}</h1>
  <p class="lead">{SITE.description}</p>

  <h2>作ったもの</h2>
  {projects.length === 0 && <p class="muted">まだありません。</p>}
  <div class="cards">
    {projects.map((p) => <ProjectCard p={p} />)}
  </div>
  {projects.length > 0 && <p><a href={`${base}projects/`}>作ったものの一覧 →</a></p>}
  {
    claudes.length > 0 && (
      <p>
        <a href={`${base}claudes/`}>Claude Code で動かすもの ({claudes.length}) →</a>
      </p>
    )
  }

  <h2>最近の更新</h2>
  <ul class="list">
    {
      posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
          <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
  <p><a href={`${base}posts/`}>すべての更新履歴 →</a></p>
</Base>
