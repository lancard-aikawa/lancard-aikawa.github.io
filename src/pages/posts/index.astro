---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../site';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="更新履歴">
  <h1>更新履歴</h1>
  <p class="lead">各ツールの Release の記録です。</p>
  <ul class="list">
    {
      posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
          <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
          {post.data.prerelease && <span class="badge">プレリリース</span>}
        </li>
      ))
    }
  </ul>
</Base>
