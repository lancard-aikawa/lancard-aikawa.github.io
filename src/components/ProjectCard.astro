---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../site';

interface Props {
  p: CollectionEntry<'projects'>;
}
const d = Astro.props.p.data;
const base = import.meta.env.BASE_URL;
const thumb = d.screenshots[0];
---

<a class="card project-card" href={`${base}projects/${d.slug}/`}>
  <div class="thumb">
    {thumb ? <img src={thumb} alt="" loading="lazy" /> : <span class="thumb-name">{d.name}</span>}
  </div>
  <div class="body">
    <h3>{d.name}</h3>
    <p>{d.tagline}</p>
    <div class="meta muted">
      {d.latest ? <>{d.latest.tag} ・ {fmtDate(d.latest.date)}</> : d.claude ? <span class="badge">Claude Code</span> : <span class="badge">リリース前</span>}
      {d.platforms && <div class="platforms">{d.platforms}</div>}
    </div>
  </div>
</a>
